# Copiez ce fichier en `.env` et renseignez les valeurs.

# Téléchargement via AppStation (plateforme de distribution des releases). Si le slug ci-dessous
# correspond à un logiciel publié sur AppStation avec au moins une release stable, le bouton de
# téléchargement direct et les notes de version affichent la version courante et renvoient vers la
# fiche AppStation (qui gère licence/essai/achat avant de livrer le fichier).
VITE_APPSTATION_BASE_URL=https://app-station.neocode.ci
VITE_APPSTATION_SOFTWARE_SLUG=myicpe
# Plateforme de release à privilégier (android, ios, windows, macos, linux, universal...).
# Laisser vide pour prendre la première release stable disponible, toutes plateformes confondues.
VITE_APPSTATION_PLATFORM=android

# Repli si AppStation n'est pas configuré ou ne renvoie aucune release : lien direct statique
# (APK ou fichier hors stores). Laisser vide pour afficher « Lien à venir ».
# Domaine différent du site : le serveur du fichier doit répondre avec Access-Control-Allow-Origin
# (et idéalement Access-Control-Expose-Headers: Content-Length) pour le suivi de progression.
VITE_APPLICATION_DIRECT_DOWNLOAD_LINK=

# URLs des fiches stores. Laisser vide pour afficher les badges en « Bientôt disponible ».
VITE_APPLICATION_APPSTORE_DOWNLOAD_LINK=
VITE_APPLICATION_PLAYSTORE_DOWNLOAD_LINK=

# Paires de thèmes DaisyUI pour clair / sombre (voir https://daisyui.com/docs/themes/ )
# Les mêmes noms doivent être déclarés dans @plugin "daisyui" { themes: ... } dans src/assets/base.css
VITE_THEME_LIGHT=garden
VITE_THEME_DARK=night
